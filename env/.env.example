# 配置参考模板
# 该文件只用于说明项目需要哪些配置，请勿填写或提交真实密码。
# 在项目根目录执行以下命令，生成本地开发配置：
# Copy-Item env\.env.example env\.env.dev
# 生成后，请在 .env.dev 中填写本机的真实配置。

# ==================== 运行环境 ====================
# 当前运行环境名称；dev 表示本地开发环境，对应 env/.env.dev
ENVIRONMENT=dev
# 是否启用调试模式；开发环境使用 true，生产环境建议使用 false
DEBUG=true

# ==================== 应用配置 ====================
# 显示在 FastAPI /docs 页面中的应用名称，可以改为其他非空名称
APP_TITLE=新闻管理系统
# 显示在 OpenAPI 文档中的应用版本号
APP_VERSION=1.0.0
# 所有业务接口共用的地址前缀；必须以 / 开头，末尾不要带 /
API_PREFIX=/api

# ==================== 跨域配置 ====================
# 允许访问后端的前端地址；多个地址使用英文逗号分隔
# 开发阶段可使用 *，生产环境建议填写具体域名
CORS_ORIGINS=*
# 允许的请求方法，例如 GET,POST,PUT,DELETE；* 表示全部允许
CORS_METHODS=*
# 允许携带的请求头；* 表示全部允许
CORS_HEADERS=*
# 是否允许浏览器跨域携带 Cookie、Authorization 等凭证；可填写 true 或 false
ALLOW_CREDENTIALS=true

# ==================== MySQL 配置 ====================
# 数据库服务地址；数据库在本机运行时填写 localhost
DATABASE_HOST=localhost
# MySQL 服务端口，默认是 3306
DATABASE_PORT=3306
# 数据库登录用户名
DATABASE_USER=root
# 数据库登录密码；这里只能写占位值，真实密码填写在 .env.dev
DATABASE_PASSWORD=your_database_password
# 项目使用的数据库名称；不存在时，启动项目会自动创建
DATABASE_NAME=news_app
# 是否在控制台打印 SQL；排查问题时可开启，生产环境建议关闭
DATABASE_ECHO=true
# 连接池中长期保留的连接数量
DATABASE_POOL_SIZE=10
# 连接池繁忙时允许临时增加的最大连接数量
DATABASE_MAX_OVERFLOW=20
# 启动项目时是否自动执行 Alembic 数据库迁移；可填写 true 或 false
DATABASE_AUTO_MIGRATE=true

# ==================== 登录配置 ====================
# 登录令牌的有效天数
TOKEN_EXPIRE_DAYS=7
